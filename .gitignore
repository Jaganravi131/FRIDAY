# ── artifacts are BUILD OUTPUTS ────────────────────────────────────────────────
# Law: `rm -rf artifacts && python -m friday build` restores everything.
# Truth lives in Markdown under memory/ and soul/. Never commit derived state.
/artifacts/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── models & weights ───────────────────────────────────────────────────────────
*.gguf
*.safetensors
*.onnx
*.bin
*.pt
*.pth
*.ckpt
*.npz

# ── ambient capture NEVER leaves the machine, never gets committed ─────────────
capture/
memory/traces/*.jsonl.gz
memory/traces/*.jsonl

# ── python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/

# ── secrets ────────────────────────────────────────────────────────────────────
# Markdown IS git-pushed, so no credential may ever live in soul/ or memory/.
*.pem
*.key
credentials*
secrets.*

# ── node / surfaces ────────────────────────────────────────────────────────────
node_modules/
dist/
.turbo/

# ── editor / os ────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# connector credentials — NEVER commit (they are per-install, not per-repo)
config/connectors.json

# ---- third-party sources fetched at verify time (scripts/tune_verify.py) ----
llama.cpp-master/

# ── container state ────────────────────────────────────────────────────────────
# `docker compose` mounts ./data when run without the named volume; memory is
# user data and never belongs in git.
/data/

# ── runtime state created by `friday serve` ───────────────────────────────────
# The token is a credential and the memory trees are the USER's data. Neither is
# part of the distribution; the CI hygiene job fails if either is ever tracked.
# ANCHORED TO THE REPO ROOT. A bare `memory/` matches `friday/memory/` at any
# depth and silently removes the memory package from the distribution — which is
# exactly what happened once, and is why these patterns start with a slash.
/config/serve.token
/config/*.token
/memory/
/soul/
/artifacts/
