# ── F.R.I.D.A.Y. ──────────────────────────────────────────────────────────────
# Copy to .env and fill in what you need. The server reads the process
# environment; it does not load this file automatically. Use:
#
#   set -a && source .env && set +a
#   friday serve
#
# Every value is optional. With no key at all, FRIDAY runs its deterministic
# simulation core: real tools, real memory, real approvals, no model bill.

# ── Brain ─────────────────────────────────────────────────────────────────────
# auto | openai | anthropic | openrouter | groq | ollama | mock | <compatible>
# FRIDAY_PROVIDER=openai
# FRIDAY_MODEL=gpt-4o-mini
# FRIDAY_BASE_URL=https://api.openai.com/v1
# FRIDAY_API_KEY=

# Standard provider keys are picked up automatically:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...

# Local models via Ollama:
# FRIDAY_PROVIDER=ollama
# FRIDAY_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# ── Loop discipline ───────────────────────────────────────────────────────────
# FRIDAY_TEMPERATURE=0.4
# FRIDAY_MAX_TOKENS=2048
# FRIDAY_MAX_STEPS=12
# FRIDAY_MAX_TOOL_CALLS=24
# FRIDAY_MAX_HISTORY_MESSAGES=80
# FRIDAY_REQUEST_TIMEOUT=90

# ── Safety ────────────────────────────────────────────────────────────────────
# never | dangerous | always  (dangerous = high-risk tools need a human)
# FRIDAY_APPROVAL=dangerous
# Require X-FRIDAY-Token on mutating API calls before exposing the port:
# FRIDAY_API_TOKEN=
# Comma-separated tools to remove entirely:
# FRIDAY_DISABLED_TOOLS=shell,python_exec
# Allow fetch_url to reach private addresses (trusted labs only):
# FRIDAY_ALLOW_PRIVATE_FETCH=0

# ── Files & state ─────────────────────────────────────────────────────────────
# FRIDAY_WORKSPACE=.
# FRIDAY_DATA_DIR=./.friday
# FRIDAY_DB_PATH=./.friday/friday.db
# FRIDAY_PLUGIN_DIRS=./examples/plugins

# ── Interface ─────────────────────────────────────────────────────────────────
# FRIDAY_HOST=0.0.0.0
# FRIDAY_PORT=8000
# friday | stark
# FRIDAY_PERSONA=friday

# ── Web search ────────────────────────────────────────────────────────────────
# Optional. Without it FRIDAY falls back to DuckDuckGo's HTML endpoint.
# TAVILY_API_KEY=
