# Copy to .env and fill what you need. Everything here is optional: with an empty
# file FRIDAY runs its simulation core and every non-generation subsystem is real.

# ── the model ──────────────────────────────────────────────────────────────────
# Any OpenAI-compatible server: llama.cpp, Ollama, LM Studio, vLLM, OpenRouter…
# FRIDAY_LLM_URL=http://127.0.0.1:8080/v1
# FRIDAY_LLM_MODEL=friday-local
# FRIDAY_LLM_KEY=not-needed

# Or Anthropic instead of a local server. If the key is missing this falls back
# to the simulation core with one line on stderr.
# FRIDAY_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# FRIDAY_ANTHROPIC_MODEL=claude-sonnet-4-5

# ── the gateway / HUD ──────────────────────────────────────────────────────────
# A fixed token. Unset means FRIDAY creates config/serve.token (0600) on boot.
# FRIDAY_WEB_TOKEN=

# Where memory/, soul/, config/ and artifacts/ live. Defaults to the repo root.
# FRIDAY_ROOT=

# ── tools ──────────────────────────────────────────────────────────────────────
# 0 = memory tools only; 1 = + web/math/clock; 2 = + workspace + connectors.
# FRIDAY_TOOLS_PHASE=0

# ── retrieval (optional extras) ────────────────────────────────────────────────
# pip install -e ".[embed,rerank]" enables the semantic path; without it the
# deterministic lexical path is used, and the pipeline says so in its diagnostics.
